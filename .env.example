# Llave de Gemini (obligatoria: coach y escáner de comida)
GEMINI_API_KEY=your_gemini_api_key_here

# ── MODO NUBE (por defecto): Supabase + login por usuario ─────────────────────
# Usa SOLO la llave pública (anon / publishable). NUNCA pongas aquí la llave
# "secret" ni "service_role".
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_llave_publica_aqui

# ── MODO LOCAL: solo para desarrollar en tu computadora (SQLite, sin login) ───
# Descomenta la siguiente línea. No lo uses en una app publicada.
# FIT_ENGINE_MODO_LOCAL=1

# (Opcional) Solo para módulos que la app de Streamlit no usa
DEEPSEEK_API_KEY=your_deepseek_api_key_here
